# =============================================================================
# Vega Quant Trading Engine — Environment Configuration
# =============================================================================
# Copy this template to .env for local overrides:
#   cp .env.example .env
# Never commit real credentials, tokens, or secrets into source control.
# =============================================================================

# ── Vega Runtime ─────────────────────────────────────────────────────────────
VEGA_ENV=development

# ── Broker Selection ─────────────────────────────────────────────────────────
# Supported options:
#   - paper : Deterministic in-memory paper broker (Default, fully automated & tested)
#   - kite  : Zerodha Kite Connect adapter (requires credentials below)
BROKER=paper

# ── Redis State Cache ─────────────────────────────────────────────────────────
# Host / local default:
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0
# Note: Under Docker Compose, Compose automatically sets:
# REDIS_URL=redis://redis:6379/0

# ── Zerodha Kite Connect Credentials ──────────────────────────────────────────
# NOTE: Zerodha Kite Connect DOES NOT offer a sandbox environment. All live
# calls and orders run against real production accounts.
# These credentials are used ONLY if BROKER=kite.
KITE_API_KEY=your_kite_api_key_here
KITE_API_SECRET=your_kite_api_secret_here
KITE_ACCESS_TOKEN=your_daily_access_token_here

# ── Telemetry & Service Endpoints ─────────────────────────────────────────────
# Host browser endpoint:
VEGA_API_URL=http://localhost:8000
# Note: Inside Docker Compose, the dashboard container connects to:
# VEGA_API_URL=http://api:8000
